upstream whisper_ws {
    server 127.0.0.1:4000 max_fails=3 fail_timeout=30s;
}

upstream voiceai_app {
    server 127.0.0.1:3000 max_fails=3 fail_timeout=30s;
}

# Rate limit bypass for trusted IPs (optional)
geo $limit {
    default 1;
    # 127.0.0.1 0;  # Uncomment to whitelist localhost
}

map $limit $limit_key {
    0 "";
    1 $binary_remote_addr;
}

server {
    listen 443 ssl http2;
    server_name voiceai.wordpressstagingsite.com;

    # SSL Configuration
    ssl_certificate     /etc/letsencrypt/live/voiceai.wordpressstagingsite.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voiceai.wordpressstagingsite.com/privkey.pem;

    # Enhanced SSL Security
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;

    # Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;

    # CORS Headers (adjust origin as needed)
add_header Access-Control-Allow-Origin "https://voiceai.wordpressstagingsite.com" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin, X-Requested-With" always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header Access-Control-Max-Age "3600" always;

    # Request size limits
    client_max_body_size 500M;
    client_body_buffer_size 1M;

    # Timeouts
    client_body_timeout 30s;
    client_header_timeout 10s;
    send_timeout 30s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # Connection limits
    limit_conn conn_limit 10;

    # Block common exploits
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~ ~$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # OPTIONS handling
    if ($request_method = OPTIONS) {
        return 204;
    }

    # Common proxy headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;

    # ---- Whisper WebSocket Backend ----
    location /whisper {
        # Rate limiting for WebSocket
        limit_req zone=ws_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://whisper_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        # WebSocket specific timeouts
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        tcp_nodelay on;
    }

    # ---- Twilio Media Stream ----
    location /twilio-stream {
        # Rate limiting for Twilio streams
        limit_req zone=ws_limit burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://voiceai_app/twilio-stream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        tcp_nodelay on;
    }

    # ---- Upload API (Strict rate limiting) ----
    location /api/upload {
        # Strict rate limit for uploads
        limit_req zone=upload_limit burst=3 nodelay;
        limit_req_status 429;

        client_max_body_size 500M;
        proxy_request_buffering off;
        proxy_buffering off;

        proxy_pass http://voiceai_app;
        proxy_http_version 1.1;

        # Upload specific timeouts
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- Authentication endpoints (if any) ----
    location ~ ^/api/(login|register|auth) {
        limit_req zone=auth_limit burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://voiceai_app;
        proxy_http_version 1.1;
    }

    # ---- General API endpoints ----
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://voiceai_app;
        proxy_http_version 1.1;
    }

    # ---- Healthcheck (no rate limiting) ----
    location = /health {
        access_log off;
        proxy_pass http://voiceai_app/health;
    }

    # ---- Static files (if any) ----
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://voiceai_app;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # ---- App traffic (default) ----
    location / {
        limit_req zone=api_limit burst=30 nodelay;
        limit_req_status 429;

        proxy_pass http://voiceai_app;
        proxy_http_version 1.1;
    }
}

# HTTP to HTTPS redirect
server {
    listen 80;
    server_name voiceai.wordpressstagingsite.com;

    # Allow Let's Encrypt verification
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
