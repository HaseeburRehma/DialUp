upstream asterisk_ws {
    server asterisk:8089;
}

upstream whisper_ws {
    server app:4000;
}

upstream voiceai_app {
    server app:3000;
}

server {
    listen 443 ssl;
    server_name voiceai.wordpressstagingsite.com;

    ssl_certificate     /etc/letsencrypt/live/voiceai.wordpressstagingsite.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voiceai.wordpressstagingsite.com/privkey.pem;

    # Allow large uploads
    client_max_body_size 500M;
    proxy_request_buffering off;
    proxy_buffering off;
    gzip off;

    # --- Common headers ---
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # ✅ Allow CORS globally
   # CORS for localhost dev
add_header Access-Control-Allow-Origin http://localhost:3000 always;
add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
add_header Access-Control-Allow-Credentials true always;
    if ($request_method = OPTIONS) {
        add_header Content-Length 0;
        add_header Content-Type "text/plain; charset=utf-8";
        return 204;
    }

    # --- SIP WebSocket (Asterisk) ---
    location /sipws {
        proxy_pass http://asterisk_ws/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }

    # --- Whisper backend ---
    location /whisper {
        proxy_pass http://whisper_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }

    # --- Twilio Media Stream WebSocket ---
    location /twilio-stream {
        proxy_pass http://127.0.0.1:3000/twilio-stream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
        proxy_buffering off;
        tcp_nodelay on;
    }

    # --- API Uploads (large files) ---
    location /api/upload {
        client_max_body_size 500M;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass http://voiceai_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }

    # --- Regular app traffic (Next.js + Express API) ---
    location / {
        proxy_pass http://voiceai_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }

    # --- Healthcheck ---
    location /health {
        proxy_pass http://voiceai_app/health;
    }
}

server {
    listen 80;
    server_name voiceai.wordpressstagingsite.com;
    return 301 https://$host$request_uri;
}
