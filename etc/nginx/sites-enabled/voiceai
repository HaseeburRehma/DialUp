upstream voiceai_app {
    server 127.0.0.1:3000;
}

server {
    listen 443 ssl http2;
    server_name voiceai.wordpressstagingsite.com;

    ssl_certificate     /etc/letsencrypt/live/voiceai.wordpressstagingsite.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voiceai.wordpressstagingsite.com/privkey.pem;

    client_max_body_size 500M;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_read_timeout 86400;
    proxy_send_timeout 86400;

    # --- Whisper (WebSocket) ---
    location /whisper {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # --- Server-Sent Events ---
    location /api/voice/stream {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Connection '';
        proxy_buffering off;
        add_header X-Accel-Buffering no;
    }

    # --- Default Next.js ---
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }
}
